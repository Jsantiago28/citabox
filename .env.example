# Copiar este archivo a ".env.local" y completar con los valores reales del proyecto de Supabase.
# NUNCA subir ".env.local" al repositorio (ya está en .gitignore).
#
# La Publishable Key es la clave segura para usar desde el navegador.
# NO usar aquí una Secret Key ni una service_role key.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
